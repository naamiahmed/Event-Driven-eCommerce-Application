# AWS Configuration
AWS_REGION=us-east-1

# DynamoDB Configuration
ORDERS_TABLE_NAME=event-driven-ecommerce-orders-dev

# EventBridge Configuration
EVENT_BUS_NAME=event-driven-ecommerce-bus-dev

# SQS Queue URLs (optional for local simulation)
PAYMENT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/event-driven-ecommerce-payment-queue-dev
NOTIFICATION_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/event-driven-ecommerce-notification-queue-dev

# Failure Simulation Modes (set to "true" to simulate worker failures and trigger DLQ behavior)
PAYMENT_FAILURE_MODE=false
NOTIFICATION_FAILURE_MODE=false
