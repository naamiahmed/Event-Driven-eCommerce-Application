{
  "name": "aws-event-driven-ecommerce",
  "version": "1.0.0",
  "description": "Production-ready, serverless event-driven e-commerce platform on AWS using EventBridge, SQS, DynamoDB, Lambda, and Terraform",
  "private": true,
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
