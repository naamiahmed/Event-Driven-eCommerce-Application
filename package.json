    "frontend": "node scripts/serve-frontend.js",
    "lint": "node scripts/lint.js"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.750.0",
    "@aws-sdk/client-eventbridge": "^3.750.0",
    "@aws-sdk/lib-dynamodb": "^3.750.0",
    "jest": "^29.7.0"
  },
  "keywords": [
    "aws",
    "serverless",
    "event-driven",
    "eventbridge",
    "sqs",
    "dynamodb",
    "lambda",
    "terraform",
    "devops"
